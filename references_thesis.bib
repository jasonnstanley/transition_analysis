  editor       = {Holton, Derek and Artigue, Mich{\`e}le and Kirchgr{\"a}ber, Urs and Hillel, Joel and Niss, Mogens and Schoenfeld, Alan},
  abstract     = {It is clear that the pre-eminent position of mathematics has been challenged, particularly in Western countries. Its position has been taken over by computing and computer-based technology. Fewer students are studying mathematics at higher levels in secondary schools, due to competition for time in the secondary curriculum. Fewer students are studying mathematics as a major at tertiary level. However the numbers studying some mathematics as part of a degree continues to increase, especially statistics and mathematical computing.}
}
