@article{Mills2021,
  title        = {{ALEKS} constructs as predictors of high school mathematics achievement for struggling students},
  author       = {Mills, Nadine J D},
  year         = 2021,
  month        = jun,
  journal      = {Heliyon},
  publisher    = {Elsevier BV},
  volume       = 7,
  number       = 6,
  pages        = {e07345},
  copyright    = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
  abstract     = {The purpose of this study was to determine what factors of the Assessment and Learning in Knowledge Spaces (ALEKS), an ITS, are predictive of struggling learners' performance in a blended-learning Algebra 1 course at an inner city technical high school located in the northeastern U.S. Three variables (student retention, engagement time, and the ratio of topics mastered to topics practiced) were used to predict the degree of association on the criterion variable (mathematics competencies), as measured by final course progress grades in algebra, and the Preliminary Scholastic Assessment Test (PSATm) math scores. A correlational predictive design was applied to assess the data of a purposive sample of 265 struggling students at the study site; multiple regression analysis was also used to investigate the predictability of these variables. Findings suggest that engagement time and the ratio of mastered to practiced topics were significant predictors of final course progress grades. Nevertheless, these factors were not significant contributors in predicting PSATm score. Retention was identified as the only statistically significant predictor of PSATm score. The results offer educators with additional insights that can facilitate improvements in mathematical content knowledge and promote higher graduation rates for struggling learners in high school mathematics.},
  keywords     = {Distance education and online learning; Secondary education; Teaching/learning strategies},
  language     = {en},
  note         = {\url{https://pmc.ncbi.nlm.nih.gov/articles/PMC8239733/}}
}

@article{Mitchell1993,
  title        = {{Modelling techniques for tutoring systems}},
  author       = {P. David Mitchell and Peter D. Grogono},
  year         = {1993},
  journal      = {Computers \& Education},
  volume       = {20},
  number       = {1},
  pages        = {55--61},
  doi          = {https://doi.org/10.1016/0360-1315(93)90070-Y},
  issn         = {0360-1315},
  url          = {https://www.sciencedirect.com/science/article/pii/036013159390070Y},
  note         = {Special Issue Selected Papers of the Sixth International Annual Conference of the PEG Group},
  abstract     = {An intelligent tutoring system (ITS) must incorporate models not only of knowledge of the real world and knowledge possessed by the learner but also of the relationship between the teacher and the learner. The role of the ITS is to coordinate a conversation between knowledge bases in both tutor and learner, simulating Socratic dialogue rather than rote learning and mechanical testing. Tutor and learner may take different perspectives but must come to agree that they share the same understanding. Modelling techniques used in ITS must be both grounded in theory and empirically validated if the ITS is to be successful. Our rationale is found in Conversation Theory. We discuss theories which provide suitable foundations for modelling in an ITS. We describe experiments performed to assess their effectiveness and we describe the ACME system built to explore modelling techniques for ITS.}
}
