  author       = {Leigh N. Wood},
  year         = {2001},
  booktitle    = {The Teaching and Learning of Mathematics at University Level: An ICMI Study},
  publisher    = {Springer Netherlands},
  address      = {Dordrecht},
  pages        = {87--98},
  doi          = {10.1007/0-306-47231-7_9},
