  editor       = {Holton, Derek and Artigue, Mich{\`e}le and Kirchgr{\"a}ber, Urs and Hillel, Joel and Niss, Mogens and Schoenfeld, Alan},
  abstract     = {What I have tried to point out in this paper with the examples of linear algebra work is that, as a mathematician, one does not need to be completely committed to using CAS nor drastically change teaching styles in order to devise some interesting CAS activities. Certainly, CAS are by and large black boxes which could easily be misused. Certainly, CAS work can entail a lot of fussing with syntax and other technical difficulties. But with thought, care, and experience, there are activities that can engage most students in a mathematical idea or confront them with unexpected results. In the process, students can become mathematically curious, and that is by itself a rewarding payoff.},
  note         = {\url{https://doi.org/10.1007/0-306-47231-7_33} and download e-book pdf \url{https://link.springer.com/content/pdf/10.1007/0-306-47231-7.pdf}}
